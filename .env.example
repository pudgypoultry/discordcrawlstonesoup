# Copy to .env and fill in. Nothing here is read automatically — export it, or
# use a tool like direnv or `set -a; . ./.env; set +a`.

# --- Discord -----------------------------------------------------------------
# The bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Channel IDs to relay in, space or comma separated. Enable Developer Mode in
# Discord, then right-click a channel and Copy ID.
DISCORD_CHANNEL_IDS=

# --- WebTiles ----------------------------------------------------------------
DCSS_WS_URL=ws://127.0.0.1:8080/socket
DCSS_SITE_URL=http://127.0.0.1:8080/
DCSS_USERNAME=
DCSS_PASSWORD=
DCSS_GAME_ID=dcss-web-trunk

# --- Pacing ------------------------------------------------------------------
# Seconds between keystrokes. Public servers ask clients to stay under 10/s;
# this is far slower on purpose, because it is more watchable.
DCSS_COMMAND_INTERVAL=0.75
DCSS_QUEUE_DEPTH=25
DCSS_QUEUE_TTL=12
DCSS_USER_COOLDOWN=0
DCSS_COLLAPSE_DUPLICATES=false

# --- Log relay ---------------------------------------------------------------
DCSS_FLUSH_IDLE=1.2
DCSS_FLUSH_MAX_LINES=18
DCSS_STATUS_LINE=true

# --- Resilience --------------------------------------------------------------
DCSS_STUCK_TIMEOUT=45
DCSS_AUTO_RESTART=true
DCSS_RESTART_DELAY=10

DCSS_LOG_LEVEL=INFO
